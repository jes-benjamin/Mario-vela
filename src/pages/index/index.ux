}

/* ===== Overlays ===== */
/* Solid background, no transparency tricks: some devices drop the whole
   style block when they hit an unsupported property like `opacity`. */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #0f0f1c;
}
/* Content panel: absolutely placed at overlayY (computed from screen height),
   so it never depends on flex centering support */
.overlay-panel {
  position: absolute;
  left: 0;
  width: 100%;
  flex-direction: column;
  align-items: center;
}
.overlay-title {
  color: #FF8C69;
  font-size: 44px;
  font-weight: bold;
  margin-bottom: 16px;
}
.overlay-sub {
  color: #aaaacc;
  font-size: 22px;
  margin-bottom: 32px;
}
.overlay-btn {
