/* ===== Game Screen ===== */
.screen-game {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #1a1a2e;
}
.hud {
  position: absolute;
  top: 18px;
  left: 0;
  width: 100%;
  flex-direction: row;
  justify-content: center;
}
.hud-text {
  color: #aaaacc;
  font-size: 22px;
}
.hud-shield {
  color: #4FC3F7;
  font-size: 22px;
  font-weight: bold;
  margin-left: 10px;
}
.game-area {
  position: absolute;
  top: 55px;
  left: 0;
  width: 100%;
  height: 299px;
  background-color: #5C94FC;
}
.world-container {
  position: absolute;
  top: 0;
  left: 0;
  height: 299px;
}

/* Tile wrapper + inner image — VelaOS compatible (no object-fit:fill, no z-index) */
.tile-wrap {
  position: absolute;
  width: 23px;
  height: 23px;
}
.tile-inner {
  width: 23px;
  height: 23px;
  flex-shrink: 0;
}
/* Player wrapper + inner image */
.player-wrap {
  position: absolute;
  width: 18px;
  height: 20px;
}
.player-inner-sm {
  width: 18px;
  height: 20px;
  flex-shrink: 0;
}
.player-inner-lg {
  width: 26px;
  height: 28px;
  flex-shrink: 0;
}
/* Item wrapper + inner image */
.item-wrap {
