<template>
  <div class="container">

    <!-- ===== Menu Screen ===== -->
    <div class="screen-menu" if="{{gameState === 'menu'}}">
      <text class="game-title">喵哩奥</text>
      <text class="game-subtitle">Meow Rio</text>
      <text class="menu-coins">金币 {{coins}}</text>
      <text class="menu-btn menu-btn-primary" onclick="startNewGame">开始游戏</text>
      <text class="menu-btn" onclick="showSaves">读取存档</text>
      <text class="menu-btn" onclick="showShop">商店</text>
      <text class="menu-btn" onclick="showAbout">关于</text>
    </div>

    <!-- ===== Save List Screen ===== -->
    <div class="screen-saves" if="{{gameState === 'saves'}}">
      <text class="screen-title">存档列表</text>
      <scroll class="save-scroll" style="height:{{saveListH}}px;" if="{{saveListDisplay.length > 0}}">
        <div class="save-list">
          <div for="{{saveListDisplay}}" tid="slot"
               class="save-item"
               onclick="loadSave($item.slot)"
               onlongpress="onSaveLongPress($item.slot)">
            <text class="save-name">{{$item.name}}</text>
            <text class="save-info-text">死亡{{$item.deaths}}次 · {{$item.timeStr}}</text>
            <text class="save-hint-text">长按删除</text>
          </div>
        </div>
      </scroll>
      <text class="save-empty" if="{{saveListDisplay.length === 0}}">暂无存档</text>
      <text class="clear-btn" onclick="confirmClearAll" if="{{saveListDisplay.length > 0}}">清空所有存档</text>
      <text class="back-hint">右滑返回主界面</text>
    </div>

    <!-- ===== Shop Screen ===== -->
    <div class="screen-shop" if="{{gameState === 'shop'}}">
      <text class="screen-title">商店</text>
      <text class="shop-coins">我的金币：{{coins}}</text>
      <list class="shop-list-view" style="height:{{shopListH}}px;">
        <list-item class="shop-header-item">
          <text class="shop-section">皮肤</text>
        </list-item>
        <list-item for="{{shopList}}" tid="uid" class="shop-row-item">
          <div class="shop-item" onclick="buyOrEquip($item.idx)">
            <image class="shop-skin-img" src="{{$item.img}}"></image>
            <div class="shop-info">
              <text class="shop-name">{{$item.name}}</text>
              <text class="shop-status">{{$item.status}}</text>
            </div>
          </div>
        </list-item>
        <list-item class="shop-header-item">
          <text class="shop-section">道具</text>
        </list-item>
        <list-item for="{{shopItems}}" tid="id" class="shop-row-item">
          <div class="shop-item" onclick="buyItem($item.idx)">
            <image class="shop-item-img" src="{{$item.img}}"></image>
            <div class="shop-info">
              <text class="shop-name">{{$item.name}}</text>
              <text class="shop-status">{{$item.status}}</text>
            </div>
          </div>
        </list-item>
      </list>
      <text class="back-hint" onclick="backToMenu">点击这里返回主界面</text>
    </div>

    <!-- ===== Delete Confirm Overlay ===== -->
    <div class="overlay" if="{{gameState === 'confirmdelete'}}">
      <div class="overlay-panel" style="top:{{overlayY}}px;">
        <text class="overlay-title">删除存档</text>
        <text class="overlay-sub">确定要删除这个存档吗？</text>
        <text class="overlay-btn" onclick="confirmDeleteSave">确认删除</text>
        <text class="overlay-btn-sm" onclick="cancelDeleteSave">取消</text>
      </div>
    </div>

    <!-- ===== About Screen ===== -->
    <div class="screen-about" if="{{gameState === 'about'}}">
      <div class="about-content">
        <image class="app-logo" src="/common/images/icon.png"></image>
        <text class="app-name">喵哩奥</text>
        <text class="app-version">V1.0.5</text>
        <text class="section-label">开发团队</text>
        <div class="dev-card">
          <text class="person-text">@矩阵工作室</text>
        </div>
        <text class="section-label">参与开发的人员</text>
        <div class="dev-card">
          <text class="person-text">@jes_（Benjamin）</text>
        </div>
        <text class="link-label">更多资源请访问</text>
        <text class="link-text">bandbbs.cn</text>
      </div>
    </div>

    <!-- ===== Game Screen ===== -->
    <div class="screen-game" if="{{gameState === 'playing' || gameState === 'dead' || gameState === 'levelcomplete'}}">
      <div class="hud" style="top:{{hudTop}}px;">
        <text class="hud-text">第{{hudLevel}}关 金币{{hudCoins}} 死亡{{hudDeaths}}次</text>
        <text class="hud-shield" if="{{hudShield}}">护盾</text>
      </div>

      <div class="game-area" style="top:{{gameTop}}px;height:{{gameH}}px;">
        <!-- World container: holds the WHOLE level, scrolled by left offset -->
        <div class="world-container" style="top:{{worldTop}}px;left:{{worldLeft}}px;width:{{worldW}}px;height:{{worldH}}px;">
          <!-- Static tiles: rendered ONCE per level (world coordinates) -->
          <div for="{{visibleTiles}}" tid="id" class="tile-wrap" style="{{$item.style}}">
            <image src="{{$item.image}}" class="tile-inner" />
          </div>
          <!-- Dynamic tiles: mushrooms / question blocks / falling platforms / checkpoints -->
          <div for="{{dynamicTiles}}" tid="id" class="tile-wrap" style="{{$item.style}}">
            <image src="{{$item.image}}" class="tile-inner" style="{{$item.imgStyle}}" />
          </div>
          <!-- Enemies: world coordinates, scroll with the map -->
          <div for="{{visibleEnemies}}" tid="id" class="enemy-wrap" style="{{$item.style}}">
            <image src="/common/images/cat_enemy.png" class="enemy-inner" />
          </div>
          <!-- Items popped from lucky blocks -->
          <div for="{{visibleItems}}" tid="id" class="item-wrap" style="{{$item.style}}">
            <image src="{{$item.image}}" class="item-inner" />
          </div>
          <!-- Player: world coordinates (camera keeps it centered) -->
          <div class="player-wrap" style="{{playerStyle}}">
            <image src="{{playerImg}}" class="{{playerInnerClass}}" />
          </div>
        </div>
      </div>

      <div class="ctrl-left" style="top:{{ctrlLeftY}}px;" ontouchstart="onLeftStart" ontouchend="onLeftEnd" ontouchmove="onLeftMove">
        <text class="ctrl-text">←</text>
      </div>
      <div class="ctrl-jump" style="top:{{ctrlJumpY}}px;" ontouchstart="onJumpStart" ontouchend="onJumpEnd">
        <text class="ctrl-text">跳</text>
      </div>
      <div class="ctrl-right" style="top:{{ctrlLeftY}}px;" ontouchstart="onRightStart" ontouchend="onRightEnd" ontouchmove="onRightMove">
        <text class="ctrl-text">→</text>
      </div>
    </div>

    <div class="overlay" if="{{gameState === 'dead'}}">
      <div class="overlay-panel" style="top:{{overlayY}}px;">
        <text class="overlay-title">你死了！</text>
        <text class="overlay-sub">再接再厉</text>
        <text class="overlay-btn" onclick="retry">重试</text>
        <text class="overlay-btn-sm" onclick="backToMenu">返回主菜单</text>
      </div>
    </div>

    <div class="overlay" if="{{gameState === 'levelcomplete'}}">
      <div class="overlay-panel" style="top:{{overlayY}}px;">
        <text class="overlay-title">过关！</text>
        <text class="overlay-sub">死亡{{hudDeaths}}次</text>
        <text class="overlay-btn" onclick="nextLevel">下一关</text>
        <text class="overlay-btn-sm" onclick="backToMenu">返回主菜单</text>
      </div>
    </div>

    <div class="overlay" if="{{gameState === 'gamecomplete'}}">
      <div class="overlay-panel" style="top:{{overlayY}}px;">
        <text class="overlay-title">通关！</text>
        <text class="overlay-sub">恭喜你成为喵哩奥大师</text>
        <text class="overlay-btn" onclick="backToMenu">返回主菜单</text>
      </div>
    </div>

  </div>
</template>

<style>
